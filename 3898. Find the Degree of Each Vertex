class Solution {
public:
    vector<int> findDegrees(vector<vector<int>>& matrix) {
        vector<int> arr;
        int sum=0;
        for(int i=0;i<matrix.size();++i){
            sum=0;
            for(int j=0;j<matrix[0].size();++j)
            {
                sum=sum+matrix[i][j];
               
            }
             arr.push_back(sum);
        }
        return arr;
    }
};
